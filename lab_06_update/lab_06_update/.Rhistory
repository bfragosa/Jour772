# Turn off scientific notation
options(scipen=999)
# Load the tidyverse, plus any other packages you will need to clean data and work with dates.
library(tidyverse)
library(janitor)
library(lubridate)
Baltimore_overdose <- read_csv("tabula-Baltimore County; Carey, Samantha log OD.csv", col_names = FALSE) %>% clean_names() %>%
rename(DAT_FORMAT = x1, DAT_FORI = x2, CASE_NBR = x3, EVTYP = x4, LOC = x5) %>%
mutate(DAT_FORMAT=mdy(DAT_FORMAT))
Baltimore_overdose %>%
group_by(DAT_FORMAT)|>
summarise(
count=n()
) |>
arrange(desc(count))
Weekly_overdose <- Baltimore_overdose %>%
mutate(weekday=wday(
DAT_FORMAT,
label = TRUE,
abbr = TRUE,
week_start = getOption("lubridate.week.start", 7),
locale = Sys.getlocale("LC_TIME")
))
Calls_each_week <- Weekly_overdose %>%
group_by(weekday) %>%
summarise(count = n()) %>%
mutate(percentage = (count / sum(count)) * 100) %>%
arrange(desc(count))
Location_of_calls <- Weekly_overdose %>%
group_by(LOC) %>%
summarise(count = n()) %>%
arrange(desc(count))
View(Weekly_overdose)
View(Calls_each_week)
combined_911 %>%
month(x, label = FALSE, abbr = TRUE, locale = Sys.getlocale("LC_TIME")) %>%
group_by(county) %>%
summarize(total_calls = n()) %>%
arrange(desc(total_calls))
combined_911 %>%
month(date, label = FALSE, abbr = TRUE, locale = Sys.getlocale("LC_TIME")) %>%
group_by(county) %>%
summarize(total_calls = n()) %>%
arrange(desc(total_calls))
combined_911 %>%
group_by(county) %>%
summarize(total_calls = n()) %>%
arrange(desc(total_calls))
