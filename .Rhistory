y = "Median Income ($)",
caption = "source: Prince Georges County EMS & Census Bureau. Graphic by Brandyn Fragosa. 10-28-2025"
) +
geom_text(vjust = 1, nudge_y = 8, check_overlap = TRUE)
theme_minimal()
ggplot(PG_with_acs, aes(x = total_calls, y = estimate, label = zipcode)) +
geom_point() +
labs(
title = "Median Income by Total Calls in Prince George's County",
x = "Total Calls",
y = "Median Income ($)",
caption = "source: Prince Georges County EMS & Census Bureau. Graphic by Brandyn Fragosa. 10-28-2025"
) +
geom_text(vjust = -3, nudge_y = 8, check_overlap = TRUE)
theme_minimal()
ggplot(PG_with_acs, aes(x = total_calls, y = estimate, label = zipcode)) +
geom_point() +
labs(
title = "Median Income by Total Calls in Prince George's County",
x = "Total Calls",
y = "Median Income ($)",
caption = "source: Prince Georges County EMS & Census Bureau. Graphic by Brandyn Fragosa. 10-28-2025"
) +
geom_text(vjust = -2, nudge_y = 0.5, check_overlap = TRUE)
theme_minimal()
ggplot(PG_with_acs, aes(x = total_calls, y = estimate, label = zipcode)) +
geom_point() +
labs(
title = "Median Income by Total Calls in Prince George's County",
x = "Total Calls",
y = "Median Income ($)",
caption = "source: Prince Georges County EMS & Census Bureau. Graphic by Brandyn Fragosa. 10-28-2025"
) +
geom_text(vjust = -0.5, nudge_y = 0.5, check_overlap = TRUE)
theme_minimal()
