library(tidyverse)
library(tidycensus)
library(lubridate)
Prince_georges_2022_overdoses <- read_csv("data/prince_georges_2022_overdoses.csv") %>%
clean_names() %>%
mutate(datetime = ymd_hms(datetime),
date = date(datetime),
week = week(datetime),
month = month(datetime, label = TRUE))
Prince_georges_calls_by_month <- Prince_georges_2022_overdoses %>%
group_by(month) %>%
summarize(total_calls = n()) %>%
mutate(pct_total_calls = (total_calls / sum(total_calls)) * 100) %>%
arrange(desc(total_calls))
Prince_georges_calls_by_month %>%
ggplot() +
geom_bar(aes(x=reorder(month,total_calls), weight=total_calls)) +
coord_flip() +
theme_minimal() +
labs(
title="Prince George's monthly overdose calls",
x = "month",
y = "total calls",
caption = "source: Prince Georges County EMS. Graphic by Brandyn Fragosa. 10-28-2025"
)
ggsave("test.png", device = "png", width = 9, height = 6, dpi = 800)
Prince_georges_calls_by_date <- Prince_georges_2022_overdoses %>%
group_by(date) %>%
summarize(total_calls = n())
Prince_georges_calls_by_date %>%
ggplot() +
geom_line(aes(x=date, y=total_calls)) +
scale_x_date(date_breaks = "1 week", date_labels = "%b %d") +
theme(
axis.text.x = element_text(angle = 45,  hjust=1)
) +
labs(
title="Prince George's weekly overdose calls",
caption = "source: Prince Georges County EMS. Graphic by Brandyn Fragosa. 10-28-2025"
)
knitr::include_graphics("https://www.mathsisfun.com/data/images/scatter-ice-cream1.svg")
View(Prince_georges_calls_by_week)
View(Prince_georges_calls_by_date)
