#load tidyverse, tidytext, rio,, janitor libraries
library(tidyverse)
library(tidytext)
library(rio)
library(janitor)
library(googlesheets4)
#renamed important details to details for simplicity
library(googlesheets4)
gs4_deauth()
news <- read_sheet("https://docs.google.com/spreadsheets/d/1XFRMzN-xK1uQcvaEIOV7wuEPH6lYrvVpvgE3w6ngKPU/edit?usp=sharing", sheet = "Form Responses 1") |>
clean_names() |>
rename(details = important_details_from_article_about_the_victim_and_the_conditions_at_cheltenham_any_direct_quotes_need_to_have_quotation_marks)
stories <- str_replace_all(news$details, "- ", "")
stories_df <- tibble(stories,)
# unnest includes lower, punct removal
stories_tokenized <- stories_df %>%
unnest_tokens(word,stories)
stories_tokenized
#A list of the common words
data(stop_words)
stories_tokenized <- stories_tokenized %>%
anti_join(stop_words, by = c("word" = "word")) %>%
filter(word != "temp_file") %>%
filter(word != "stories_corpus") %>%
filter(!grepl('[0-9]', word))
# Word Count of top words
word_count <- stories_tokenized %>%
count(word, sort=TRUE)
bigrams <- stories_df %>%
unnest_tokens(bigram, stories, token="ngrams", n=2) |>
separate(bigram, c("word1", "word2"), sep = " ")
count_bigrams <- bigrams %>%
count(word1, word2, sort = TRUE)
bigrams_clean <-stories_df %>%
unnest_tokens(bigram, stories, token="ngrams", n=2) |>
separate(bigram, c("word1", "word2"), sep = " ") |>
filter(!word1 %in% stop_words$word) %>%
filter(!word2 %in% stop_words$word) |>
filter(!is.na(word1) | !is.na(word2))
count_clean_bigrams <- bigrams_clean  %>%
count(word1, word2, sort = TRUE)
news <- news |>
mutate(details_clean = str_squish(str_remove_all(details, "[[:punct:]]"))) |>
mutate(category = paste(
if_else(str_detect(details_clean, "(?i)sentenced"), "origins", NA_character_),
if_else(str_detect(details_clean, "(?i)committed"), "origins", NA_character_),
if_else(str_detect(details_clean, "(?i)labor"), "labor", NA_character_),
if_else(str_detect(details_clean, "(?i)farm"), "labor", NA_character_),
if_else(str_detect(details_clean, "(?i)broom"), "labor", NA_character_),
if_else(str_detect(details_clean, "(?i)larceny"), "boy_offenses", NA_character_),
if_else(str_detect(details_clean, "(?i)conditions"), "treatment", NA_character_),
if_else(str_detect(details_clean, "(?i)jury"), "investigations", NA_character_),
if_else(str_detect(details_clean, "(?i)beaten"), "abuse", NA_character_),
sep = "; "
)) |>
mutate(category = str_remove_all(category, "NA; |; NA")) |>
mutate(category = na_if(category, "NA"))
news <- news |>
rename(jquality = elaborate_on_the_quality_of_the_journalism_sourcing_graphics_photos_interviews, abuse = notes_on_neglect_or_abuse, noteworthy = notes_anything_else_thats_noteworthy)
journalism <- str_replace_all(news$jquality, "- ", "")
journalism_df <- tibble(journalism,)
journalism_tokenized <- journalism_df %>%
unnest_tokens(word,journalism)
journalism_tokenized
##This generated common words that were initially submitted into the "elaborate_on_the_quality_of_the_journalism_sourcing_graphics_photos_interviews" box on the Google form.
bigrams2 <- journalism_df %>%
unnest_tokens(bigram2, journalism, token="ngrams", n=2) |>
separate(bigram2, c("word1", "word2"), sep = " ")
count_bigrams2 <- bigrams2 %>%
count(word1, word2, sort = TRUE)
#This made a data set separating the top words into two columns.Then it created another data set counting the results so I could see the top used responses.
mistreatment <- str_replace_all(news$abuse, "- ", "")
mistreatment_df <- tibble(mistreatment,)
mistreatment_tokenized <- mistreatment_df %>%
unnest_tokens(word,mistreatment)
mistreatment_tokenized
##This produced a table of a lot of repeated words or "na" or didn't answer. It looks like a lot of people provided the same response when it came to allegations of abuse or neglect.
bigrams3 <- mistreatment_df %>%
unnest_tokens(bigram3, mistreatment, token="ngrams", n=2) |>
separate(bigram3, c("word1", "word2"), sep = " ")
count_bigrams3 <- bigrams3 %>%
count(word1, word2, sort = TRUE)
#This made a data set separating the results of the previous code into two columns.Then it created another data set counting the results so I could see the top used responses.
noteworthynews <- str_replace_all(news$noteworthy, "- ", "")
noteworthynews_df <- tibble(noteworthynews,)
noteworthynews_tokenized <- noteworthynews_df %>%
unnest_tokens(word,noteworthynews)
noteworthynews_tokenized
#This list seems to have the most diverse responses since it was more like a free response box in the Google form.
bigram4 <- noteworthynews_df %>%
unnest_tokens(bigram4,noteworthynews, token="ngrams", n=2) |>
separate(bigram4, c("word1", "word2"), sep = " ")
count_bigram4 <- bigram4 %>%
count(word1, word2, sort = TRUE)
#This made a data set separating the results of the previous code into two columns.Then it created another data set counting the results so I could see the top used responses.
