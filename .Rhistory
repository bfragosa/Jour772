Society_crime_2025 <- Society_crime_2025 %>% mutate(year = 2025)
Society_crime_data_all <- bind_rows(Society_crime_2023, Society_crime_2024, Society_crime_2025)
Society_crime_change <- Society_crime_data_all %>%
select(crime_type, year, total) %>%
filter(!is.na(total)) %>%
arrange(crime_type, year) %>%
group_by(crime_type) %>%
mutate(
percent_change = ((total - lag(total)) / lag(total)) * 100,
change_from_2023 = ((total - first(total)) / first(total)) * 100
)
