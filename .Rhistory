labs(x = "Year", y = "Number of Articles", color = "Newspaper") +
theme_minimal()
View(Cheltenham_ex)
Cheltenham_ex <- read_csv("C:/Users/frago/Downloads/Cheltenham Article Data Extraction (Responses) AK & BF - Form Responses 1 (1).csv") %>% clean_names()
View(Cheltenham_ex)
Cheltenham_ex <- Cheltenham_ex %>%
mutate(date_of_article = mdy(date_of_article))
Cheltenham_ex %>%
group_by(newspaper_name) %>%
summarize(count = n()) %>%
arrange(desc(count))
Dated_Cheltenham_ex <- Cheltenham_ex %>%
group_by(newspaper_name, date_of_article) %>%
summarize(count = n()) %>%
arrange(date_of_article)
Cheltenham_ex %>%
mutate(year = year(date_of_article)) %>%
group_by(newspaper_name, year) %>%
summarize(count = n()) %>%
ggplot(aes(x = year, y = count, fill = newspaper_name)) +
geom_col(position = "dodge") +
labs(title = "Cheltenham Articles Over The Years",
x = "Year",
y = "Number of Articles",
fill = "Newspaper",
caption = "source: Library of Congress. Graphic by Brandyn Fragosa. 11-20-2025")
ggsave("Cheltenham_article_graph.png", device = "png", width = 9, height = 6, dpi = 800)
