# Turn off scientific notation
options(scipen=999)
library(tidyverse)
library(tidycensus)
usethis::edit_r_environ()
# a new text file opens in RStudio
# Check if .gitignore exists in your project
file.exists(".gitignore")
system("git status")
ACS23 <- load_variables(2023, "acs5", cache = TRUE)
md <- get_acs(geography = "county",
variables = c(medage = "B01002_001"),
state = 'MD',
year = 2023)
md %>%
filter(estimate >= 50)
montgomery_2022_overdoses <- read_csv("data/montgomery_2022_overdoses.csv") %>%
mutate(zip = as.character(zip))
total_calls <- montgomery_2022_overdoses %>%
group_by(zip) %>%
summarise(total_calls=n()) %>%
arrange(desc(total_calls))
md18 <- get_acs(geography = 'county',
variables = c(pop18 = 'B09021_001'),
state = 'MD',
year = 2022)
md18 <- get_acs(geography = 'county',
variables = c(pop18 = 'B09021_001'),
state = 'MD',
year = 2022) %>%
mutate(GEOID = as.character(GEOID))
Montgomery_with_acs <- montgomery_2022_overdoses %>%
left_join(md18, by = c('zip'='GEOID'))
View(Montgomery_with_acs)
Montgomery_with_acs <- montgomery_2022_overdoses %>%
left_join(md18, by = c('zip'='GEOID'))
View(Montgomery_with_acs)
head(Montgomery_with_acs)
View(md18)
