# Turn off scientific notation
options(scipen=999)
# load your packages
library(tidyverse)
library(janitor)
library(lubridate)
library(refinr)
# Load the Maryland expenditures data table
maryland_expenses <- read_csv("data/maryland_expenses.csv") %>% clean_names()
media_expenses <- maryland_expenses %>%
filter(
str_detect(expense_category, "Media")) %>%
mutate(payee_clean=n_gram_merge(payee_name))
media_expenses %>%
select(payee_name, payee_clean, everything())
View(media_expenses)
expenses_summary <- payee_clean %>%
mutate(
payee_FB = case_when(
str_detect(payee_clean, regex("Meta", ignore_case = TRUE)) ~ "Facebook",
.default = payee_clean
))
expenses_summary <- payee_clean %>%
mutate(
payee_FB = case_when(
str_detect(payee_clean, regex("Meta", ignore_case = TRUE)) ~ "Facebook",
.default = payee_clean
))
expenses_summary <- media_expenses %>%
mutate(
payee_FB = case_when(
str_detect(payee_clean, regex("Meta", ignore_case = TRUE)) ~ "Facebook",
.default = payee_clean
))
expenses_summary %>%
filter(str_detect(payee_FB, "Facebook")) %>%
group_by(committee_name) %>%
summarize(total_amount = sum(amount)) %>%
arrange(desc(total_amount))
View(expenses_summary)
expenses_summary %>%
filter(str_detect(committee_name, "Moore  Wes For Maryland") %>%
(str_detect(committee_name, "Moore Miller For Maryland Slate"))
