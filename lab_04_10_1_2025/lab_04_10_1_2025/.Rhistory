filter(
str_detect(committee_name, "Moore  Wes For Maryland")|
str_detect(committee_name, "Moore Miller For Maryland Slate"))
expenses_summary %>%
filter(
str_detect(committee_name, "Moore  Wes For Maryland")|
str_detect(committee_name, "Moore Miller For Maryland Slate")) %>%
group_by(committee_name) %>%
summarize(total_amount = sum(amount)) %>%
arrange(desc(total_amount))
