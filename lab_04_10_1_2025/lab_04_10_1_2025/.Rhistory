expenses_summary <- Payee_clean %>%
mutate(
payee_FB = case_when(
str_detect(payee_clean, " Facebook "),
str_detect(payee_clean, " Meta "),
.default = NA
)
)
expenses_summary <- Payee_clean %>%
mutate(
payee_FB = case_when(
str_detect(payee_clean, " Facebook ") ~ "Facebook",
str_detect(payee_clean, " Meta ") ~ "Meta",
.default = NA
)
)
View(expenses_summary)
expenses_summary <- Payee_clean %>%
mutate(
payee_FB = case_when(
str_detect(payee_clean, " Facebook ") ~ "Facebook",
str_detect(payee_clean, " Meta ") ~ "Facebook",
.default = NA
)) %>%
group_by(Payee_FB) %>%
summarise(total_amount = sum(amount, na.rm=TRUE))
