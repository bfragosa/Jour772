ACS23 <- load_variables(2023, "acs5", cache = TRUE)
md <- get_acs(geography = 'zcta',
variables = c(medincome = "B07011_001"),
year = 2023)%>%
mutate(GEOID = as.character(GEOID))
PG_with_acs <- PG_zip_codes %>%
left_join(md, by = c('zipcode'='GEOID'))
library(ggplot2)
ggplot(PG_with_acs, aes(x = total_calls, y = estimate)) +
geom_point() +
labs(
title = "Median Income by Total Calls in Prince George's County",
x = "Total Calls",
y = "Median Income ($)",
caption = "source: Prince Georges County EMS & Census Bureau. Graphic by Brandyn Fragosa. 10-28-2025"
) +
theme_minimal()
