options(scipen=999)
install.packages("ggrepel")
install.packages("ggplot2")
library(tidyverse)
library(janitor)
library(lubridate)
library(ggplot2)
library(ggrepel)
library(tidycensus)
library(ggthemes)
Cheltenham_ex <- read_csv("Cheltenham_Article_Data_Extraction.csv") %>% clean_names()
list.files()
Cheltenham_ex <- read_csv("Cheltenham Article Data Extraction.csv") %>% clean_names()
Cheltenham_ex <- Cheltenham_ex %>%
mutate(date_of_article = mdy(date_of_article))
Cheltenham_ex %>%
group_by(newspaper_name) %>%
summarize(count = n()) %>%
arrange(desc(count))
Dated_Cheltenham_ex <- Cheltenham_ex %>%
group_by(newspaper_name, date_of_article) %>%
summarize(count = n()) %>%
arrange(date_of_article)
article_type <- Cheltenham_ex %>%
group_by(article_type) %>%
summarize(count = n()) %>%
arrange(article_type)
Dated_Cheltenham_ex <- Cheltenham_ex %>%
group_by(newspaper_name, date_of_article) %>%
summarize(count = n()) %>%
arrange(date_of_article)
article_type <- Cheltenham_ex %>%
group_by(article_type) %>%
summarize(count = n()) %>%
arrange(article_type)
yearly_Cheltenham <- Cheltenham_ex %>%
mutate(year = year(date_of_article)) %>%
group_by(year) %>%
summarise(count = n()) %>%
arrange(count)
View(Cheltenham_ex)
knitr::opts_chunk$set(echo = TRUE)
options(scipen=999)
install.packages("ggrepel")
install.packages("ggplot2")
library(tidyverse)
library(janitor)
library(lubridate)
library(ggplot2)
library(ggrepel)
library(tidycensus)
library(ggthemes)
Cheltenham_ex <- read_csv("Cheltenham Article Data Extraction.csv") %>% clean_names()
View(Cheltenham_ex)
Cheltenham_ex <- Cheltenham_ex %>%
mutate(date_of_article = mdy(date_of_article))
Cheltenham_ex %>%
group_by(newspaper_name) %>%
summarize(count = n()) %>%
arrange(desc(count))
Dated_Cheltenham_ex <- Cheltenham_ex %>%
group_by(newspaper_name, date_of_article) %>%
summarize(count = n()) %>%
arrange(date_of_article)
article_type <- Cheltenham_ex %>%
group_by(article_type) %>%
summarize(count = n()) %>%
arrange(article_type)
yearly_Cheltenham <- Cheltenham_ex %>%
mutate(year = year(date_of_article)) %>%
group_by(year) %>%
summarise(count = n()) %>%
arrange(count)
yearly_Cheltenham %>%
ggplot(aes(x = year, y = count)) +
geom_col(fill = "steelblue", position = "dodge") +
labs(x = "Year",
y = "Total Number of Articles",
title = "Cheltenham Articles Over Time",
caption = "Source: Library of Congress. Graphic by Brandyn Fragosa. 11-21-2025")
ggsave("Cheltenham_article_graph.png", device = "png", width = 9, height = 6, dpi = 800)
View(Dated_Cheltenham_ex)
View(yearly_Cheltenham)
