location = ifelse(is.na(`UMD Case Number`), df[[1]], NA)
) %>%
# Fill location down to all subsequent rows until next location
fill(location, .direction = "down") %>%
# Remove the location rows (where UMD Case Number is NA)
filter(!is.na(`UMD Case Number`))
