knitr::opts_chunk$set(echo = TRUE)
options(scipen=999)
library(tidyverse)
library(janitor)
library(lubridate)
fatal_police_shootings_data <- read_csv("fatal-police-shootings-data.csv") %>%
clean_names() %>%
mutate(date = ymd(date))
fatal_police_shootings_agencies <- read_csv("fatal-police-shootings-agencies.csv") %>%
clean_names()
fatal_police_shootings_data_v1 <- read_csv("fatal-police-shootings-data-v1.csv") %>%
clean_names()
View(fatal_police_shootings_agencies)
View(fatal_police_shootings_data_v1)
# Men and woman shot by police in 2015 who had mental illnesses.
fatal_police_shootings_data_v1 %>%
filter(
str_detect(gender, "male")|
str_detect(gender, "female"),
str_detect(was_mental_illness_related, "TRUE")
) %>%
group_by(gender) %>%
summarise(count = n()) %>%
mutate(percentage = (count / sum(count)) * 100)
# Men and woman shot by police in 2015 who had mental illnesses.
fatal_police_shootings_data_v1 %>%
filter(
str_detect(gender, "male")|
str_detect(gender, "female"),
str_detect(signs_of_mental_illness, "TRUE")
) %>%
group_by(gender) %>%
summarise(count = n()) %>%
mutate(percentage = (count / sum(count)) * 100)
# Men and woman shot by police in 2015 who had mental illnesses.
fatal_police_shootings_data_v1 %>%
filter(
str_detect(gender, "M")|
str_detect(gender, "F"),
str_detect(signs_of_mental_illness, "TRUE")
) %>%
group_by(gender) %>%
summarise(count = n()) %>%
mutate(percentage = (count / sum(count)) * 100)
combined_fatal_police_shootings_data <- bind_rows(fatal_police_shootings_data, fatal_police_shootings_data_v1))
combined_fatal_police_shootings_data <- bind_rows(fatal_police_shootings_data, fatal_police_shootings_data_v1)
View(combined_fatal_police_shootings_data)
View(fatal_police_shootings_data)
View(fatal_police_shootings_data_v1)
# Men and woman shot by police in 2015 who had mental illnesses.
fatal_police_shootings_data %>%
filter(
str_detect(gender, "male")|
str_detect(gender, "female"),
str_detect(was_mental_illness_related, "TRUE")
) %>%
group_by(gender) %>%
summarise(count = n()) %>%
mutate(percentage = (count / sum(count)) * 100)
# Men and woman shot by police in 2015 who had mental illnesses.
fatal_police_shootings_data %>%
filter(
str_detect(gender, "male")|
str_detect(gender, "female"),
str_detect(was_mental_illness_related, "TRUE")
)
# Men and woman shot by police in 2015 who had mental illnesses.
fatal_police_shootings_data %>%
filter(
str_detect(gender, "male")|
str_detect(gender, "female"),
str_detect(was_mental_illness_related, "TRUE")
)%>%
group_by(gender) %>%
summarise(count = n())
